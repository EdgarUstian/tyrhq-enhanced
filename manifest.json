{
    "manifest_version": 3,
    "name": "Tyr HQ Enhanced",
    "version": "0.1.0",
    "description": "Enhancements for Tyr HQ.",
    "content_scripts": [
        {
            "matches": [
                "https://tyrhq.com/*",
                "https://www.tyrhq.com/*"
            ],
            "js": [
                "src/vehicle-data.js",
                "src/stat-data.js",
                "src/comparison-table.js",
                "src/content.js"
            ],
            "css": [
                "src/styles.css"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "data/runtime.json"
            ],
            "matches": [
                "https://tyrhq.com/*",
                "https://www.tyrhq.com/*"
            ]
        }
    ]
}